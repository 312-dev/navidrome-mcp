{
  "name": "navidrome-mcp",
  "version": "1.0.0",
  "description": "Navidrome MCP server — mood/vibe-aware playlist generation over a personal music library, grounded in Navidrome metadata, ListenBrainz listening history and Last.fm tags",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "navidrome-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "npx tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check:vocab": "tsx scripts/check-vocabulary.ts",
    "check:dedupe": "tsx scripts/check-dedupe.ts",
    "check:source": "tsx scripts/check-source.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "fetch-socks": "^1.3.3",
    "undici": "^7.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": false,
    "clean": true,
    "outDir": "dist",
    "target": "node20",
    "external": [
      "@modelcontextprotocol/sdk",
      "zod",
      "fetch-socks",
      "undici"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
